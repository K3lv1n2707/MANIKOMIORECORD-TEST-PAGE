# Copia estas variables en Easypanel (pestaña Environment). NO subas un archivo .env real a GitHub.

# Usuario y contraseña del primer administrador (solo se usan la primera vez que arranca).
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contraseña

# Clave secreta para las sesiones: una frase larga y aleatoria (mínimo 32 caracteres).
SESSION_SECRET=pega-aqui-una-clave-larga-y-aleatoria

# Ya vienen configuradas en el Dockerfile; solo cámbialas si sabes lo que haces.
# PORT=3000
# DATA_DIR=/app/data
